FROM postgres:15-alpine

# Copy migration and seed files
COPY database/migrations/*.sql /docker-entrypoint-initdb.d/
COPY database/seeds/*.sql /docker-entrypoint-initdb.d/
COPY .docker/init-db.sh /docker-entrypoint-initdb.d/

# Make init script executable
RUN chmod +x /docker-entrypoint-initdb.d/init-db.sh

# Set environment variables
ENV POSTGRES_DB=phoenix_dashboard
ENV POSTGRES_USER=postgres
ENV POSTGRES_PASSWORD=postgres

EXPOSE 5432
